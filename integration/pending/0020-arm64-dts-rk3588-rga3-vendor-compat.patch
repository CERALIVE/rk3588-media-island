Subject: arm64: dts: rockchip: stage RK3588 RGA3 ownership for multi_rga

Prepare the RGA3 compatible-only ownership flip for the later RGA release.
This patch remains under integration/pending and is deliberately excluded from
the generated release series until todo 19 promotes both RGA patches together.

Reference: armbian/linux-rockchip@fd9f82366e235b8afbdf516765210e97d24dce93:arch/arm64/boot/dts/rockchip/rk3588s.dtsi

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
@@ -1263,7 +1263,7 @@
 	};
 
 	rga3_core0: rga@fdb60000 {
-		compatible = "rockchip,rk3588-rga3";
+		compatible = "rockchip,rga3_core0";
 		reg = <0x0 0xfdb60000 0x0 0x200>;
 		interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH 0>;
 		clocks = <&cru ACLK_RGA3_0>, <&cru HCLK_RGA3_0>, <&cru CLK_RGA3_0_CORE>;
@@ -1285,7 +1285,7 @@
 	};
 
 	rga3_core1: rga@fdb70000 {
-		compatible = "rockchip,rk3588-rga3";
+		compatible = "rockchip,rga3_core1";
 		reg = <0x0 0xfdb70000 0x0 0x200>;
 		interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH 0>;
 		clocks = <&cru ACLK_RGA3_1>, <&cru HCLK_RGA3_1>, <&cru CLK_RGA3_1_CORE>;

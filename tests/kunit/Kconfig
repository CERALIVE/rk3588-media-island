config ROCKCHIP_MPP_BOUNDARY_KUNIT_TEST
	tristate "Rockchip MPP request-boundary tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Exercise the pure request-shape, element-count, class-coverage, and
	  result-copy bounds shared by the RK3588 MPP clients.

config ROCKCHIP_MPP_FAULT_KUNIT_TEST
	tristate "Rockchip MPP fault-injection tests"
	depends on KUNIT
	select WANT_DEV_COREDUMP
	default KUNIT_ALL_TESTS
	help
	  Exercise the atomic one-shot semantics used by the opt-in RKVENC2
	  fault-injection controls.

config ROCKCHIP_MPP_RECOVERY_KUNIT_TEST
	tristate "Rockchip MPP recovery-state tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Exercise session teardown ordering and pending, running, timeout,
	  finish, and done task transitions without RK3588 hardware.

config ROCKCHIP_MPP_CAPABILITIES_KUNIT_TEST
	tristate "Rockchip MPP capability-reporting tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Prove userspace sees only clients that are both compiled and probed.

config ROCKCHIP_MPP_TELEMETRY_KUNIT_TEST
	tristate "Rockchip MPP telemetry format tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Freeze the operator-visible MPP load row produced by the driver.

config ROCKCHIP_RGA_FENCE_KUNIT_TEST
	tristate "Rockchip RGA release-fence tests"
	depends on KUNIT
	select DMA_SHARED_BUFFER
	default KUNIT_ALL_TESTS
	help
	  Exercise the production release-fence terminal helper for every RGA
	  request exit class that must wake an asynchronous consumer.

config ROCKCHIP_RGA_REQUEST_KUNIT_TEST
	tristate "Rockchip RGA request-validation tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Exercise fail-closed per-plane descriptor, offset, stride, and
	  format validation without binding the RGA driver.

config ROCKCHIP_MEDIA_DMA_POLICY_KUNIT_TEST
	tristate "Rockchip media DMA policy tests"
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Exercise per-block address widths and DMA mapping-size limits.

config ROCKCHIP_MEDIA_IOCTL_KUNIT_TEST
	bool "Rockchip media direct ioctl boundary tests"
	depends on KUNIT && 64BIT
	depends on !COMPAT
	depends on !ROCKCHIP_MPP_SERVICE && !ROCKCHIP_MULTI_RGA
	select DMA_SHARED_BUFFER
	help
	  Compile the maintained ioctl and session functions with bounded user-copy
	  fixtures. No hardware driver is registered. Run stage_ioctl.py first.

config ROCKCHIP_MEDIA_RUNTIME_PM_KUNIT_TEST
	bool "Rockchip media runtime-PM ownership tests"
	depends on KUNIT && PM
	depends on !ROCKCHIP_MPP_SERVICE && !ROCKCHIP_MULTI_RGA
	help
	  Exercise maintained RGA power/cancellation and JPEG probe functions
	  with real runtime-PM devices and fake hardware. Run stage_ioctl.py first.

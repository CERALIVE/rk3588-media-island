# kernel-pin.env — the kernel this island's modules are built and tested against.
#
# THIS FILE IS A MIRROR, NOT A DECISION. The four `KERNEL_*` values below are
# copied byte-for-byte out of `rk3588-kernel-patches/kernel-pin.env`, which is
# the single source of truth for the kernel coordinate the whole CeraLive RK3588
# track builds against. That repository resolves them live with its own
# `scripts/preflight.sh`, independently of the informational Armbian mapping; this
# repository does not re-derive anything and must never disagree.
#
# Island CI has a `pin-equality` job that fetches the consumer repo's file at the
# named CONSUMER_PIN_REF and compares these four lines. A hand-edit here is a red build,
# which is the point: the island's modules-only cross-compile proves nothing if
# it ran against a kernel the device never boots.
#
# Bumping the kernel is a change to `rk3588-kernel-patches` FIRST. Only once that
# repo has re-anchored its series onto the new tag does this mirror move.
#
# Rule D: island CI clones the kernel by URL from the values below. It never
# reads a sibling checkout, and no path here escapes this repository's root.
#
# shellcheck shell=bash
# shellcheck disable=SC2034  # pure data file; every value is consumed by a sourcing caller

# ---------------------------------------------------------------------------
# MIRRORED BLOCK — byte-identical to rk3588-kernel-patches/kernel-pin.env.
# Do not reformat, re-quote, or strip the inline comments.
# ---------------------------------------------------------------------------
KERNEL_TAG="v7.4-rc2"
KERNEL_TAG_OBJECT="fd9230005e85472b81c1c7c16afe93dd878996b1"      # refs/tags/v7.4-rc2 (annotated tag object)
KERNEL_COMMIT="7475ea8b58616b33c04afb976cf0fbaad9dd63fb"          # v7.4-rc2^{commit}
KERNEL_MIRROR="https://github.com/torvalds/linux.git"

# ---------------------------------------------------------------------------
# ISLAND-LOCAL BUILD COORDINATES — not mirrored; this repository owns them.
# ---------------------------------------------------------------------------

# Main uses main; candidate branches name the consumer branch they mirror.
CONSUMER_PIN_REF="rebase/v7.4"

# The two module directories the island builds out of tree. CI runs one
# `make M=<dir> modules` per entry against the kernel pinned above.
ISLAND_MODULE_DIRS="drivers/video/rockchip/mpp drivers/video/rockchip/rga3"

# Cross toolchain for the arm64 modules-only build.
ISLAND_ARCH="arm64"
ISLAND_CROSS_COMPILE="aarch64-linux-gnu-"
